{
  "name": "construction-monitor",
  "version": "1.0.0",
  "description": "Real-Time Construction Project Monitoring Dashboard desktop application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,RENDERER,ELECTRON\" -c \"yellow,blue,green\" \"npm run dev:backend\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:backend": "node src/backend/server.js",
    "dev:electron": "wait-on tcp:5173 tcp:5001 && electron .",
    "build": "vite build",
    "test": "vitest run"
  },
  "keywords": [
    "construction",
    "monitoring",
    "iot",
    "electron",
    "react",
    "express",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^1.16.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "supertest": "^7.0.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  }
}
